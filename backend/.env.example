# Copy to .env and adjust. Backend also works with no .env (defaults below).
PORT=5000
HOST=127.0.0.1
# Where the SQLite file lives (relative to backend/)
DATABASE=minco.db
# Comma-separated origins allowed to call the API (file:// needs "*" via null handling)
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:8000,http://localhost:8000
# Optional: later plug a real AI provider for /api/chat (leave empty = offline rules)
AI_PROVIDER=
OPENAI_API_KEY=
